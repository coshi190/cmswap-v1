# Ponder indexer (CORS-open; the browser calls /graphql directly)
NEXT_PUBLIC_PONDER_URL=https://junoswap-production.up.railway.app

# Bridge Aggregator (e.g., LI.FI)
# NEXT_PUBLIC_LIFI_INTEGRATOR=cmswap

# WalletConnect (get a free project ID at https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# IPFS Upload (Pinata)
PINATA_JWT=your_pinata_jwt_token
